@{
    ViewData["Title"] = "Las piezas del ajedrez";
}
<script>
    // Ejemplo simple con jQuery: scroll suave
    $('a[href^="#"]').on('click', function (e) {
        e.preventDefault();
        $('html, body').animate({
            scrollTop: $($(this).attr('href')).offset().top
        }, 600);
    });
</script>

<style>
    .hero {
        background-image: url('https://www.chessbazaar.com/blog/wp-content/uploads/2017/08/dsc0352_copy_3_1.jpg');
        background-size: cover;
        background-position: center;
        color: white;
        padding: 100px 20px;
        text-align: center;
    }

    .section-icon {
        font-size: 40px;
        color: gold;
    }
</style>


<!-- Hero Section -->
<section class="hero">
    <h1 class="display-3 fw-bold">ChessTutor</h1>
    <p class="lead">Aprende ajedrez desde lo básico hasta lo avanzado</p>
    <a asp-action="Inicio" class="btn btn-warning btn-lg mt-4">Comienza a aprender</a>
</section>

<!-- Secciones -->
<section class="container py-5" id="learn">
    <div class="row text-center">
        <div class="col-md-4">
            <a asp-action="Inicio" class="text-decoration-none text-reset">
                <div class="section-icon mb-3">♙</div>
                <h4>Aprende lo básico</h4>
                <p>Entiende cómo se mueve cada pieza y las reglas fundamentales.</p>
            </a>
        </div>
        <div class="col-md-4">
            <div class="section-icon mb-3">♘</div>
            <h4>Tácticas y estrategias</h4>
            <p>Mejora tu juego con aperturas, trampas y visión táctica.</p>
        </div>
        <div class="col-md-4">
            <a asp-action="JugarStockfish" class="text-decoration-none text-reset">
                <div class="section-icon mb-3">🤖</div>
                <h4>Juega contra la IA</h4>
                <p>Practica contra una inteligencia artificial que se adapta a tu nivel.</p>
            </a>
        </div>
    </div>
</section>